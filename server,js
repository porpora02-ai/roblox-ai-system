const express = require("express");
const cors = require("cors");
const bodyParser = require("body-parser");

const app = express();

app.use(cors());
app.use(bodyParser.json());

// Render requires this
const PORT = process.env.PORT || 3000;

// Simple in-memory storage
let projects = {};

// AI GENERATOR (MVP version)
function generateProject(prompt) {

    prompt = prompt.toLowerCase();

    // 🎮 MENU SYSTEM
    if (prompt.includes("menu")) {
        return {
            projectName: "MainMenuProject",

            scripts: [
                {
                    type: "LocalScript",
                    name: "MainMenu",
                    location: "StarterPlayerScripts",
                    code: `
local player = game.Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "MainMenu"
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(1,0,1,0)
frame.BackgroundColor3 = Color3.fromRGB(20,20,20)
frame.Parent = gui

local button = Instance.new("TextButton")
button.Size = UDim2.new(0,220,0,60)
button.Position = UDim2.new(0.5,-110,0.5,-30)
button.Text = "PLAY"
button.TextScaled = true
button.Parent = frame

button.MouseButton1Click:Connect(function()
	gui.Enabled = false
end)
`
                }
            ]
        };
    }

    // DEFAULT PROJECT
    return {
        projectName: "EmptyProject",
        scripts: []
    };
}

// 🔧 Generate project
app.post("/generate", (req, res) => {

    const { prompt, userId } = req.body;

    if (!prompt || !userId) {
        return res.status(400).json({ error: "Missing prompt or userId" });
    }

    const project = generateProject(prompt);
    projects[userId] = project;

    res.json(project);
});

// 📦 Get project (Roblox uses this)
app.get("/project/:userId", (req, res) => {

    const project = projects[req.params.userId];

    if (!project) {
        return res.status(404).json({ error: "No project found" });
    }

    res.json(project);
});

// 🚀 Start server
app.listen(PORT, () => {
    console.log("Server running on port " + PORT);
});
